# Configuration: docs/06-INFRASTRUCTURE.md, section 7.
# `npm run setup` copies this file to .env. The values below run the app locally
# without an account on any outside service; never put real secrets in this file.

# Local Postgres from docker-compose.yml. Tests derive their own database from it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/comproparati

# Better Auth. Use a long random value outside local development.
BETTER_AUTH_SECRET=local-development-only-replace-outside-localhost

# Google OAuth. Optional locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development-only sign-in by email (Infrastructure §7). Works only on localhost;
# never set it in production.
DEV_SIGN_IN=true

# Vercel Blob. Empty locally, where thumbnails are saved to a folder.
BLOB_READ_WRITE_TOKEN=

# Resend. Empty locally, where email is printed to the console.
RESEND_API_KEY=
EMAIL_FROM="ComproParaTi <noreply@example.com>"

# Protects the daily email route.
CRON_SECRET=local-development-only-replace-outside-localhost

# The app's own address, also Better Auth's base address.
APP_URL=http://localhost:3000

SUPPORT_EMAIL=support@example.com
